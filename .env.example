# Password login dashboard
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Kunci untuk enkripsi API key provider & sesi login (min. 16 karakter, acak).
# JANGAN diganti setelah provider tersimpan, nanti API key provider tidak bisa didekripsi.
APP_SECRET=ganti-dengan-string-acak-panjang

PORT=8787
HOST=0.0.0.0

# Lokasi database SQLite (relatif ke root project)
DB_PATH=data/gateway.db

# Opsional: OAuth client untuk adapter Antigravity
# AG_OAUTH_CLIENT_ID=
# AG_OAUTH_CLIENT_SECRET=
